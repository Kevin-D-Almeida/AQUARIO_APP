# Copie este arquivo para .env.production apenas na VM.
# Nunca envie o arquivo real para o GitHub.

API_DOMAIN=api.seu-dominio.com

DB_NAME=aquario
DB_USER=aquario
DB_PASSWORD=troque-por-uma-senha-forte-sem-caracteres-de-url
DB_ROOT_PASSWORD=troque-por-outra-senha-forte
DATABASE_URL=mysql://aquario:troque-por-uma-senha-forte-sem-caracteres-de-url@database:3306/aquario

JWT_SECRET=troque-por-um-segredo-aleatorio-com-pelo-menos-64-caracteres

# Use uma chave Resend real e um remetente de domínio verificado no Resend.
RESEND_API_KEY=re_substitua_pela_chave_de_producao
RESEND_FROM_EMAIL=no-reply@seu-dominio.com

# Deve usar o mesmo host configurado em API_DOMAIN.
APP_BASE_URL=https://api.seu-dominio.com
MOBILE_APP_URL=aquariomobile://reset-password
